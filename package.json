{
  "name": "velmara-insights-engine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43217",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 43217",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "test:watch": "vitest",
    "create-admin": "tsx scripts/create-admin.ts",
    "test:e2e": "playwright test",
    "ci": "vitest run && playwright test",
    "test:e2e:features": "playwright test e2e/features",
    "test:e2e:feature": "playwright test --grep",
    "test:evals": "playwright test e2e/features --grep \"gold case\""
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.46.0",
    "mammoth": "^1.12.3",
    "mermaid": "^12.0.0",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
