# Optional locally — required for live PPTX charts (LlamaCloud) and Claude extraction.

# Postgres (required for the IEGP store)
DATABASE_URL=postgres://synapse:synapse@127.0.0.1:5432/synapse

# LlamaParse v2 (charts, graphs, graphics in PPTX/PDF)
LLAMA_CLOUD_API_KEY=
LLAMA_PARSE_TIER=agentic

# Claude Sonnet — optional live extract
ANTHROPIC_API_KEY=
