# Optional locally — required for live PPTX charts (LlamaCloud) and Claude extraction.

# Postgres (required for the IEGP store)
DATABASE_URL=postgres://synapse:synapse@127.0.0.1:5432/synapse

# LlamaParse v2 (charts, graphs, graphics in PPTX/PDF)
LLAMA_CLOUD_API_KEY=
LLAMA_PARSE_TIER=agentic

# Claude — live gap extract (proposer / critic / judge)
# Preferred: Claude Code OAuth (`claude /login`). Tokens live in
# ~/.claude/.credentials.json or these env vars. API keys still work as fallback.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_REFRESH_TOKEN=
# CLAUDE_CODE_CREDENTIALS_PATH=
# AGENTIC_AUTH=auto
ANTHROPIC_API_KEY=
# Required when the key is identity-linked (not scoped to one workspace)
ANTHROPIC_WORKSPACE_ID=
# Optional: GitHub PAT (repo scope) so this environment can push to github.com/Shashb21/synapse
# GH_TOKEN=
