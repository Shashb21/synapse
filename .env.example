# Postgres (required for the IEGP store and the platform tables)
DATABASE_URL=postgres://synapse:synapse@127.0.0.1:5432/synapse
# Optional connection pool sizes (KAN-14). Workspace pool: default 10 (3 on Vercel).
# Platform pool (sessions, workspaces, routing): default 4 (2 on Vercel).
# DATABASE_POOL_MAX=10
# DATABASE_PLATFORM_POOL_MAX=4

# TLS follows sslmode (KAN-20). localhost with no sslmode, or sslmode=disable: plain TCP.
# sslmode=require / verify-full, or any remote host: TLS with the certificate verified.
# A private CA (RDS, self-hosted) goes here as PEM text:
# DATABASE_CA_CERT=
# Last resort only: TLS without checking the certificate.
# DATABASE_SSL_VERIFY=false

# Limits (KAN-20). Defaults shown; leave unset unless you need to change them.
# SYNAPSE_LLM_TIMEOUT_MS=120000          # a provider call that takes longer is stopped
# SYNAPSE_JSON_BODY_MAX_BYTES=5242880    # largest JSON API request (an upload is at most 3 MB)
# SYNAPSE_MAX_PARSE_UNITS=2000           # text sections parsed per document
# SYNAPSE_MAX_PARSE_CALLS=50             # model calls per document parse
# SYNAPSE_MAX_WORKSPACES_PER_USER=20     # workspaces one person may create

# ---------------------------------------------------------------------------
# LLM access is the owner's job, never an end user's. Every provider uses one
# server-side API key from the environment (here in .env.local, or your host's
# settings). There is no provider login. The owner console at /admin/control
# shows only whether each key is set and which env var it comes from, never the
# value, and sets per-stage routing. A provider with no key is "not
# configured": routing to it fails with a message naming the env var to set, and
# everything can still be done by hand.
# Whether AI runs at all is not an env setting: the master switch is in
# /admin/control and each workspace owner has an "AI assistance" setting.
# Never commit real keys; inject them via the environment only.
# ---------------------------------------------------------------------------

# xAI · Grok — the default route. Sent as `Authorization: Bearer`.
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODELS=grok-4,grok-4-fast,grok-3

# Anthropic · Claude — the locked one-click alternate. Sent as `x-api-key`.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# First entry is the default model.
# ANTHROPIC_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-4-5-20251001
# Required when the Claude key is org-scoped (not workspace-scoped). The accuracy
# lab only routes to Claude when this is set; Grok needs nothing extra.
# ANTHROPIC_WORKSPACE_ID=

# OpenAI · ChatGPT. Sent as `Authorization: Bearer`.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-5.1,gpt-5.1-mini,o4-mini

# Google · Gemini (Generative Language API). Sent as `x-goog-api-key`.
# Free test LLM (KAN-70): a free Google AI Studio key (aistudio.google.com/apikey) with
# GEMINI_MODELS=gemini-3.8-flash first, then "Route every stage to" Gemini in AI & routing.
# Free-tier 429s are waited out and retried; a per-day quota is reported, not retried.
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.1-pro-preview

# OpenRouter. Sent as `Authorization: Bearer`.
# Free test LLM (KAN-70): a free OpenRouter key with a ":free" model that supports JSON,
# e.g. OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
# Free models allow 50 requests a day (1000 once the account holds $10 credit).
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=x-ai/grok-4,anthropic/claude-sonnet-4.5,openai/gpt-5.1

# ---------------------------------------------------------------------------
# App sign-in (identity, not LLM access). With no identity provider set, only
# staff password accounts can sign in (plus a demo sign-in in development).
# ---------------------------------------------------------------------------

# REQUIRED in production. Signs the workspace-selection cookie. At least 32
# random characters (e.g. `openssl rand -base64 48`). A production server
# refuses to start without it; development falls back to a fixed dev value.
# SESSION_SECRET=

# Platform owners (admin console, accuracy lab, routing, AI switch):
# comma-separated emails. Matched only against an identity provider's VERIFIED
# email, never a demo sign-in.
# OWNER_EMAILS=owner@example.com

# Optional: only verified emails on these domains may sign in (comma-separated,
# exact match, e.g. `kernelfood.co,partner.example`). Unset = any verified or
# unverified account the identity provider admits.
# ALLOWED_EMAIL_DOMAINS=

# There is no self sign-up. Customers sign in ONLY with one of the identity
# providers below, and only when their verified email holds a seat you assigned
# at /admin/customers (anyone else is refused at /login). Email + password
# sign-in is for your own staff: the admin account is created with
# `npm run create-admin` (prompts for the password), further staff accounts at
# /admin/users. No password or admin email goes in this file.
#
# Configure at least one provider for customers. Each needs an OAuth app whose
# redirect URI is https://<your-host>/api/auth/callback
# (local: http://localhost:43217/api/auth/callback). A provider's button appears
# on /login as soon as its *_IDP_CLIENT_ID is set.

# Google: only a Google-verified email (email_verified=true) is used.
# GOOGLE_IDP_CLIENT_ID=
# GOOGLE_IDP_CLIENT_SECRET=

# Microsoft Entra ID: AZURE_TENANT_ID is REQUIRED (your directory id). The
# multi-tenant "common"/"organizations"/"consumers" endpoints are refused unless
# MICROSOFT_ALLOW_MULTI_TENANT=1. The email is used only when verified: add the
# `xms_edov` optional claim to the ID token in the app registration, otherwise
# people are identified by their Microsoft subject and email invites won't match.
# MICROSOFT_IDP_CLIENT_ID=
# MICROSOFT_IDP_CLIENT_SECRET=
# AZURE_TENANT_ID=
# MICROSOFT_ALLOW_MULTI_TENANT=

# GitHub: the account's primary verified email (from /user/emails) is used.
# GITHUB_IDP_CLIENT_ID=
# GITHUB_IDP_CLIENT_SECRET=

# Document parsing needs no extra service or key: every uploaded file is parsed
# by the LLM chosen for the parse stage (routing in /admin/control).

# Optional: GitHub PAT (repo scope) so this environment can push to github.com/Shashb21/synapse
# GH_TOKEN=
