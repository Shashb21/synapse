# Postgres (required for the IEGP store and the platform tables)
DATABASE_URL=postgres://synapse:synapse@127.0.0.1:5432/synapse

# ---------------------------------------------------------------------------
# LLM routing prefers OAuth login in /control. Optional server-side API keys
# below unlock Claude / Grok / OpenAI when no OAuth session is connected.
# Never commit real secrets; inject via the environment only.
# ---------------------------------------------------------------------------

# xAI · Grok — the locked default route (xAI OAuth in the control panel)
# XAI_OAUTH_CLIENT_ID=
# XAI_OAUTH_CLIENT_SECRET=
# XAI_OAUTH_AUTHORIZE_URL=https://accounts.x.ai/oauth/authorize
# XAI_OAUTH_TOKEN_URL=https://api.x.ai/oauth/token
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODELS=grok-4,grok-4-fast,grok-3
# XAI_API_KEY=

# Anthropic · Claude — the locked one-click alternate
# ANTHROPIC_OAUTH_CLIENT_ID=
# ANTHROPIC_OAUTH_AUTHORIZE_URL=https://claude.ai/oauth/authorize
# ANTHROPIC_OAUTH_TOKEN_URL=https://console.anthropic.com/v1/oauth/token
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODELS=claude-sonnet-4-5,claude-opus-4-1,claude-haiku-4-5
# ANTHROPIC_API_KEY=
# Required when the Claude key is org-scoped (not workspace-scoped). Live extract
# prefers Grok OAuth (or any connected provider) and does not need this.
# ANTHROPIC_WORKSPACE_ID=

# OpenAI · ChatGPT
# OPENAI_OAUTH_CLIENT_ID=
# OPENAI_OAUTH_CLIENT_SECRET=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-5.1,gpt-5.1-mini,o4-mini
# OPENAI_API_KEY=
# Google · Gemini
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_CLOUD_PROJECT=
# GEMINI_MODELS=gemini-2.5-pro,gemini-2.5-flash

# OpenRouter — client-less PKCE, so no client id is required
# OPENROUTER_OAUTH_CLIENT_ID=
# OPENROUTER_MODELS=x-ai/grok-4,anthropic/claude-sonnet-4.5,openai/gpt-5.1

# ---------------------------------------------------------------------------
# App sign-in (identity, not LLM access). With none of these set the app runs in
# demo mode and the typed-name gate stands in for a session.
# ---------------------------------------------------------------------------

# REQUIRED in production. Signs the workspace-selection cookie. At least 32
# random characters (e.g. `openssl rand -base64 48`). A production server
# refuses to start without it; development falls back to a fixed dev value.
# SESSION_SECRET=

# Platform owners (admin console, accuracy lab, routing, AI switch):
# comma-separated emails. Matched only against an identity provider's VERIFIED
# email, never a demo sign-in.
# OWNER_EMAILS=owner@example.com

# Optional: only verified emails on these domains may sign in (comma-separated,
# exact match, e.g. `kernelfood.co,partner.example`). Unset = any verified or
# unverified account the identity provider admits.
# ALLOWED_EMAIL_DOMAINS=

# Email + password sign-in is always on. Self sign-up on /signup is open by
# default; set ALLOW_SIGNUP=0 to close it (an admin then creates accounts at
# /admin/users). The admin account itself is created with `npm run create-admin`
# (prompts for the password); no password or admin email goes in this file.
# ALLOW_SIGNUP=

# Google: only a Google-verified email (email_verified=true) is used.
# GOOGLE_IDP_CLIENT_ID=
# GOOGLE_IDP_CLIENT_SECRET=

# Microsoft Entra ID: AZURE_TENANT_ID is REQUIRED (your directory id). The
# multi-tenant "common"/"organizations"/"consumers" endpoints are refused unless
# MICROSOFT_ALLOW_MULTI_TENANT=1. The email is used only when verified: add the
# `xms_edov` optional claim to the ID token in the app registration, otherwise
# people are identified by their Microsoft subject and email invites won't match.
# MICROSOFT_IDP_CLIENT_ID=
# MICROSOFT_IDP_CLIENT_SECRET=
# AZURE_TENANT_ID=
# MICROSOFT_ALLOW_MULTI_TENANT=

# GitHub: the account's primary verified email (from /user/emails) is used.
# GITHUB_IDP_CLIENT_ID=
# GITHUB_IDP_CLIENT_SECRET=

# Document parsing — every file is parsed by the LLM on the parse route (/control).
# LlamaParse is disabled for now; these are unused and kept only for re-enabling it later.
# LLAMA_CLOUD_API_KEY=
# LLAMA_PARSE_TIER=agentic

# Optional: GitHub PAT (repo scope) so this environment can push to github.com/Shashb21/synapse
# GH_TOKEN=
