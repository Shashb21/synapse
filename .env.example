# Postgres (required for the IEGP store and the platform tables)
DATABASE_URL=postgres://synapse:synapse@127.0.0.1:5432/synapse

# ---------------------------------------------------------------------------
# LLM routing prefers OAuth login in /control. Optional server-side API keys
# below unlock Claude / Grok / OpenAI when no OAuth session is connected.
# Never commit real secrets; inject via the environment only.
# ---------------------------------------------------------------------------

# xAI · Grok — the locked default route (xAI OAuth in the control panel)
# XAI_OAUTH_CLIENT_ID=
# XAI_OAUTH_CLIENT_SECRET=
# XAI_OAUTH_AUTHORIZE_URL=https://accounts.x.ai/oauth/authorize
# XAI_OAUTH_TOKEN_URL=https://api.x.ai/oauth/token
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODELS=grok-4,grok-4-fast,grok-3
# XAI_API_KEY=

# Anthropic · Claude — the locked one-click alternate
# ANTHROPIC_OAUTH_CLIENT_ID=
# ANTHROPIC_OAUTH_AUTHORIZE_URL=https://claude.ai/oauth/authorize
# ANTHROPIC_OAUTH_TOKEN_URL=https://console.anthropic.com/v1/oauth/token
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODELS=claude-sonnet-4-5,claude-opus-4-1,claude-haiku-4-5
# ANTHROPIC_API_KEY=
# Required when the Claude key is org-scoped (not workspace-scoped). Live extract
# prefers Grok OAuth (or any connected provider) and does not need this.
# ANTHROPIC_WORKSPACE_ID=

# OpenAI · ChatGPT
# OPENAI_OAUTH_CLIENT_ID=
# OPENAI_OAUTH_CLIENT_SECRET=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-5.1,gpt-5.1-mini,o4-mini
# OPENAI_API_KEY=
# Google · Gemini
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_CLOUD_PROJECT=
# GEMINI_MODELS=gemini-2.5-pro,gemini-2.5-flash

# OpenRouter — client-less PKCE, so no client id is required
# OPENROUTER_OAUTH_CLIENT_ID=
# OPENROUTER_MODELS=x-ai/grok-4,anthropic/claude-sonnet-4.5,openai/gpt-5.1

# ---------------------------------------------------------------------------
# App sign-in (identity, not LLM access). With none of these set the app runs in
# demo mode and the typed-name gate stands in for a session.
# ---------------------------------------------------------------------------
# GOOGLE_IDP_CLIENT_ID=
# GOOGLE_IDP_CLIENT_SECRET=
# MICROSOFT_IDP_CLIENT_ID=
# MICROSOFT_IDP_CLIENT_SECRET=
# AZURE_TENANT_ID=
# GITHUB_IDP_CLIENT_ID=
# GITHUB_IDP_CLIENT_SECRET=

# Document parsing — LlamaParse for PDF and PPTX (service credential, not end-user path).
# Required for PDF/PPTX uploads on /accuracy/sources (in-app gate if unset). Never commit the value.
LLAMA_CLOUD_API_KEY=
LLAMA_PARSE_TIER=agentic

# Optional: GitHub PAT (repo scope) so this environment can push to github.com/Shashb21/synapse
# GH_TOKEN=
