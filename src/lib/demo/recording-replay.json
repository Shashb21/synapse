    {
      "stage": "S1",
      "purpose_hash": "8871581b06a0982c6c21e3e5ab29d3f7fd774fb4763c0e958675016ba41bc08d",
      "system_hash": "e23025ec2783830886b84e13a2a47c1da450bfee6f1e5f28510e360a7015c41c",
      "user_hash": "b4d6e6ed04f52089ed9522ec0f459b42642af8e4b34b316e53bbfefe7819fc29",
      "ids": [],
      "reply": "{\"units\":[{\"unit\":\"u15\",\"blocks\":[{\"text\":\"- \\\"Response rate in the brain is not enough; I need to know it holds.\\\" (academic medical oncologist, US)\",\"kind\":\"bullet\",\"heading\":\"2. THEME 1 — BRAIN METASTASES AND INTRACRANIAL DURABILITY (raised in 46 percent of interactions)\"}],\"dropped_reason\":null},{\"unit\":\"u16\",\"blocks\":[{\"text\":\"- \\\"Half my patients at progression have new or growing brain lesions. If Velmara delays radiotherapy, that matters a lot.\\\" (radiation oncologist, EU5)\",\"kind\":\"bullet\",\"heading\":\"2. THEME 1 — BRAIN METASTASES AND INTRACRANIAL DURABILITY (raised in 46 percent of interactions)\"}],\"dropped_reason\":null},{\"unit\":\"u21\",\"blocks\":[{\"text\":\"- \\\"I need to see what my peers are doing after osimertinib and how patients do.\\\" (community medical oncologist, US)\",\"kind\":\"bullet\",\"heading\":\"3. THEME 2 — SEQUENCING AFTER OSIMERTINIB (raised in 38 percent)\"}],\"dropped_reason\":null},{\"unit\":\"u22\",\"blocks\":[{\"text\":\"- \\\"Is there a reason to use NX-441 before Velmara, or the other way round?\\\" (academic medical oncologist, EU5)\",\"kind\":\"bullet\",\"heading\":\"3. THEME 2 — SEQUENCING AFTER OSIMERTINIB (raised in 38 percent)\"}],\"dropped_reason\":null},{\"unit\":\"u26\",\"blocks\":[{\"text\":\"- \\\"The trial patients are younger and fitter than mine. What happens in my 78-year-old with heart disease?\\\" (community medical oncologist, US)\",\"kind\":\"bullet\",\"heading\":\"4. THEME 3 — OLDER AND FRAIL PATIENTS (raised in 33 percent)\"}],\"dropped_reason\":null},{\"unit\":\"u27\",\"blocks\":[{\"text\":\"- \\\"Families carry a lot of the burden with oral drugs: monitoring, transport, side effects at home. Nobody measures that.\\\" (oncology nurse, EU5)\",\"kind\":\"bullet\",\"heading\":\"4. THEME 3 — OLDER AND FRAIL PATIENTS (raised in 33 percent)\"}],\"dropped_reason\":null},{\"unit\":\"u28\",\"blocks\":[{\"text\":\"- \\\"Show me quality of life in patients like the ones I treat, not only EORTC in a trial.\\\" (academic medical oncologist, EU5)\",\"kind\":\"bullet\",\"heading\":\"4. THEME 3 — OLDER AND FRAIL PATIENTS (raised in 33 percent)\"}],\"dropped_reason\":null},{\"unit\":\"u30\",\"blocks\":[{\"text\":\"- Comparative effectiveness in elderly patients versus the standard of care they would otherwise receive is not established.\",\"kind\":\"bullet\",\"heading\":\"4. THEME 3 — OLDER AND FRAIL PATIENTS (raised in 33 percent)\"}],\"dropped_reason\":null},{\"unit\":\"u31\",\"blocks\":[{\"text\":\"- There is insufficient evidence on caregiver burden and on PROs in frail patients.\",\"kind\":\"bullet\",\"heading\":\"4. THEME 3 — OLDER AND FRAIL PATIENTS (raised in 33 percent)\"}],\"dropped_reason\":null},{\"unit\":\"u34\",\"blocks\":[{\"text\":\"- \\\"We do not do routine ECGs in our satellite clinics. I need a practical monitoring plan.\\\" (community medical oncologist, US)\",\"kind\":\"bullet\",\"heading\":\"5. THEME 4 — SAFETY MONITORING IN ROUTINE CARE (raised in 27 percent)\"}],\"dropped_reason\":null},{\"unit\":\"u35\",\"blocks\":[{\"text\":\"- \\\"How quickly does ILD come on, and what should a community practice do about it?\\\" (pharmacist, US)\",\"kind\":\"bullet\",\"heading\":\"5. THEME 4 — SAFETY MONITORING IN ROUTINE CARE (raised in 27 percent)\"}],\"dropped_reason\":null},{\"unit\":\"u39\",\"blocks\":[{\"text\":\"- \\\"Our pathway committee will want persistence data before they put it ahead of NX-441.\\\" (community practice pharmacist, US)\",\"kind\":\"bullet\",\"heading\":\"6. THEME 5 — ACCESS AND COST (raised in 19 percent, mostly US)\"}],\"dropped_reason\":null},{\"unit\":\"u40\",\"blocks\":[{\"text\":\"- \\\"Payers are already asking about IRA pricing for the class.\\\" (US IDN oncology lead)\",\"kind\":\"bullet\",\"heading\":\"6. THEME 5 — ACCESS AND COST (raised in 19 percent, mostly US)\"}],\"dropped_reason\":null},{\"unit\":\"u41\",\"blocks\":[{\"text\":\"- \\\"Recurrence is expensive: repeat scans, biopsies, admissions. Is anyone measuring that?\\\" (academic medical oncologist, US)\",\"kind\":\"bullet\",\"heading\":\"6. THEME 5 — ACCESS AND COST (raised in 19 percent, mostly US)\"}],\"dropped_reason\":null},{\"unit\":\"u43\",\"blocks\":[{\"text\":\"- Six-month discontinuation and persistence in US routine care are expected by pathway committees.\",\"kind\":\"bullet\",\"heading\":\"6. THEME 5 — ACCESS AND COST (raised in 19 percent, mostly US)\"}],\"dropped_reason\":null},{\"unit\":\"u44\",\"blocks\":[{\"text\":\"- HCPs and IDNs perceive a high but unquantified burden of recurrence (emergency department use, hospitalisations, outpatient visits).\",\"kind\":\"bullet\",\"heading\":\"6. THEME 5 — ACCESS AND COST (raised in 19 percent, mostly US)\"}],\"dropped_reason\":null},{\"unit\":\"u46\",\"blocks\":[{\"text\":\"- Long-term overall survival (raised in 12 percent): HCPs accept that OS will be immature at first read-out but want a plan for longer follow-up.\",\"kind\":\"bullet\",\"heading\":\"7. LOWER-FREQUENCY THEMES\"}],\"dropped_reason\":null},{\"unit\":\"u47\",\"blocks\":[{\"text\":\"- Congress presence (raised in 4 percent, mostly by internal stakeholders): requests for more symposia. Field medical regards this as a communication topic, not an evidence gap.\",\"kind\":\"bullet\",\"heading\":\"7. LOWER-FREQUENCY THEMES\"}],\"dropped_reason\":null}]}"
    },
